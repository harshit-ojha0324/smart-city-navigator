# Copy to .env and fill in as needed. Every value is optional — the agent runs
# fully offline (deterministic planner + simulated feed) with none of them set.

# ── LLM (enables real model reasoning instead of the deterministic planner) ──
# auto (default) | gemini | ollama | openai | none
# NAVIGATOR_LLM_PROVIDER=auto
#
# Hosted: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# NAVIGATOR_MODEL=gemini-2.5-flash
#
# Local, no key and no data leaving the machine (ollama pull qwen3:8b):
# NAVIGATOR_LLM_PROVIDER=ollama
# NAVIGATOR_MODEL=qwen3:8b
# NAVIGATOR_LLM_BASE_URL=http://127.0.0.1:11434

# ── LangSmith tracing / evals (optional) ─────────────────────────────────────
# LANGSMITH_API_KEY=
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=smart-city-navigator

# ── Runtime ──────────────────────────────────────────────────────────────────
# Gateway tool transport: "mcp" (live servers) or "inprocess"
NAVIGATOR_TRANSPORT=inprocess
# Force the offline GTFS-RT simulation instead of hitting the live MTA feed
NAVIGATOR_SIMULATE_FEED=0
# Redis URL for the alerts cache (falls back to in-memory if unset/unreachable)
# REDIS_URL=redis://localhost:6379/0
# Persist agent checkpoints to a file (default in-memory)
# NAVIGATOR_CHECKPOINT=checkpoints.sqlite
